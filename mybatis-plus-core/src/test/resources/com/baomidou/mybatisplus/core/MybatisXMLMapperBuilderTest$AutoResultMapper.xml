<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.baomidou.mybatisplus.core.MybatisXMLMapperBuilderTest$AutoResultMapper">
    <resultMap id="extendedResultMap"
               type="com.baomidou.mybatisplus.core.MybatisXMLMapperBuilderTest$AutoResultEntity"
               extends="mybatis-plus_AutoResultEntity">
        <result property="name" column="name"/>
    </resultMap>
    <select id="selectById" resultMap="mybatis-plus_AutoResultEntity">
        SELECT id, name FROM zz_xml_auto_result WHERE id = #{id} AND name = 'xml'
    </select>
    <select id="selectExtended" resultMap="extendedResultMap">
        SELECT id, name FROM zz_xml_auto_result
    </select>
</mapper>
